{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm db:up)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:seed:*)",
      "Bash(pnpm db:generate:*)",
      "Bash(pnpm design:contrast)",
      "Bash(pnpm check:policy)",
      "mcp__unmet__db_query",
      "mcp__unmet__describe_table",
      "mcp__unmet__list_investigations",
      "mcp__unmet__run_trace"
    ],
    "ask": [
      "Bash(pnpm db:reset:*)",
      "Bash(pnpm llm:record:*)",
      "Bash(pnpm eval:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production.local)",
      "Read(./.env.test)",
      "Read(./data/raw/**)"
    ]
  }
}
