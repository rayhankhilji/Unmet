# Local development. Copy to .env.local; every value here is fake and safe to commit.
# The full table, with which process reads what, is in ARCHITECTURE.md §12.

APP_URL=http://localhost:3000

# Postgres 16 + pgvector from `pnpm db:up` (docker compose, port 5433)
DATABASE_URL=postgres://unmet:unmet@localhost:5433/unmet
DATABASE_URL_UNPOOLED=postgres://unmet:unmet@localhost:5433/unmet

# Model providers — worker and cli only; the web app never reads these (G-SEC-13)
ANTHROPIC_API_KEY=sk-ant-fake-key
OPENAI_API_KEY=sk-fake-key
MODEL_AGENT=claude-sonnet-5-5
MODEL_EXTRACT=claude-haiku-5-5
MODEL_VISION=claude-haiku-5-5
MODEL_JUDGE=claude-opus-5-5
MODEL_FALLBACK=claude-opus-5-5
TRANSCRIBE_MODEL=whisper-1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODE=replay

# Storage: `fs` writes to .data/storage/; `r2` needs the four R2_* values
STORAGE_DRIVER=fs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=unmet-media

# Rate limiting: `memory` locally, `upstash` in production
RATE_LIMIT_DRIVER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Access control (32+ random characters in real deployments)
DEMO_PASSCODE=local-demo-passcode
ADMIN_TOKEN=local-admin-token-0123456789abcdef
ADMIN_COOKIE_SECRET=local-cookie-secret-0123456789abcdef
IP_HASH_SALT=local-ip-salt-0123456789abcdef0123
COMMENT_HASH_SALT=local-comment-salt-0123456789abcdef

# Behaviour
PUBLIC_DEMO_MODE=true
LIVE_RUNS_ENABLED=false
DAILY_LIVE_RUN_BUDGET_USD=15
RUN_TOKEN_BUDGET=600000
WORKER_ID=worker-local

# Observability — leave empty to disable
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
